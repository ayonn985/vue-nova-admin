{
  "name": "vue3-nova-admin-mini-template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "cloudflare:build": "vite build --base=./",
    "github:build": "vite build --base=/vue-nova-admin/",
    "preview": "vite preview",
    "release": "release-it",
    "release:first": "release-it --no-git.requireUpstream",
    "release:alpha": "release-it --preRelease=alpha",
    "release:beta": "release-it --preRelease=beta",
    "release:rc": "release-it --preRelease=rc",
    "release:preRelease": "release-it --preRelease",
    "format": "prettier --write .",
    "lint": "eslint src --fix"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@vueuse/core": "^10.11.0",
    "animate.css": "^4.1.1",
    "axios": "^1.7.2",
    "element-plus": "^2.7.6",
    "mitt": "^3.0.1",
    "normalize.css": "^8.0.1",
    "nprogress": "^0.2.0",
    "pinia": "^2.1.7",
    "pinia-plugin-persistedstate": "^3.2.1",
    "vue": "^3.4.31",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^8.0.1",
    "@vitejs/plugin-vue": "^5.0.4",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-vue": "^9.25.0",
    "postcss": "^8.4.38",
    "prettier": "^3.2.5",
    "release-it": "^17.4.1",
    "sass": "^1.77.6",
    "tailwindcss": "^3.4.4",
    "unplugin-auto-import": "^0.17.6",
    "unplugin-vue-components": "^0.27.2",
    "vite": "^5.3.3"
  }
}
